# Rename this file to .env
# Algolia — read-only search key for productsListing, landingPages_auto, guideCategories_auto
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=

# AWS S3 — bucket for sitemap upload
S3_BUCKET=ringgitplus-v4-files

# Google Chat — webhook URL for notifications
GCHAT_WEBHOOK_URL=

# GitHub — token for private repo clone (ringgitplus4 route files)
GITHUB_TOKEN=

# Set to "true" to skip S3 upload
DRY_RUN=
